{
  "name": "@akinozgen17/selectablejs",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.2.0",
  "description": "Framework-agnostic, zero-dependency, premium select component. Flexible like select2, featureful like bootstrap-select, unbreakable design.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akinozgen/selectable.git"
  },
  "author": "Akın Özgen <akinozgen17@outlook.com>",
  "main": "./dist/selectable.cjs",
  "module": "./dist/selectable.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/selectable.js",
      "require": "./dist/selectable.cjs"
    },
    "./css": "./dist/selectable.css",
    "./css/tokens": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "docs/llm.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs --port 4173",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4173"
  },
  "keywords": [
    "select",
    "dropdown",
    "combobox",
    "multiselect",
    "vanilla",
    "framework-agnostic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@playwright/test": "^1.62.1",
    "codemirror": "^6.0.2",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  }
}
