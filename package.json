{
  "name": "selectable",
  "version": "0.1.0",
  "description": "Framework-agnostic, zero-dependency, premium select component. Flexible like select2, featureful like bootstrap-select, unbreakable design.",
  "type": "module",
  "private": true,
  "main": "./dist/selectable.cjs",
  "module": "./dist/selectable.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/selectable.js",
      "require": "./dist/selectable.cjs"
    },
    "./css": "./dist/selectable.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "select",
    "dropdown",
    "combobox",
    "multiselect",
    "vanilla",
    "framework-agnostic"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
