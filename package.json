{
  "name": "@akinozgen17/selectablejs",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "Framework-agnostic, zero-dependency, premium select component. Flexible like select2, featureful like bootstrap-select, unbreakable design.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akinozgen/selectable.git"
  },
  "author": "Akın Özgen <akinozgen17@outlook.com>",
  "main": "./dist/selectable.cjs",
  "module": "./dist/selectable.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/selectable.js",
      "require": "./dist/selectable.cjs"
    },
    "./css": "./dist/selectable.css",
    "./css/tokens": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "docs/llm.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "select",
    "dropdown",
    "combobox",
    "multiselect",
    "vanilla",
    "framework-agnostic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
